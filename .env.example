# Copy to .env.local for local development. In production, set these in
# Netlify: Site configuration > Environment variables.
#
# Both values are public by design (they ship in the browser bundle). Every
# permission check runs in Supabase (Row Level Security), not in the browser.
# Find them in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key here or in Netlify. The website doesn't use it.
